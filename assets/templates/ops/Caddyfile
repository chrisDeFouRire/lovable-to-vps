staging.{{BASE_DOMAIN}} {
	root * /var/www/{{APP_SLUG}}-staging
	try_files {path} /index.html
	file_server
}

supabase-staging.{{BASE_DOMAIN}} {
	reverse_proxy 127.0.0.1:{{STAGING_KONG_HTTP_PORT}}
}

