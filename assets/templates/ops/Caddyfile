	root * /var/www/{{APP_SLUG}}-production
	try_files {path} /index.html
	file_server
}

supabase-prod.{{BASE_DOMAIN}} {
	reverse_proxy 127.0.0.1:{{PRODUCTION_KONG_HTTP_PORT}}
}
